# .env.example — copy to .env for local development.
# Never commit .env — it contains real credentials.
# All variables follow 12-factor III: config in the environment.
# Variables without a default listed are required.

# ── Database (server + worker) ────────────────────────────────────────────
# Individual vars are assembled into a postgres:// DSN at startup.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=georef
DB_USER=georef
DB_PASSWORD=changeme
# DB_SSLMODE=disable

# ── Storage (server + worker) ─────────────────────────────────────────────
# Select filesystem (default) or s3. Only one set of vars below is required.

# STORAGE_BACKEND=filesystem

# -- Filesystem backend (default)
STORAGE_ROOT=/data/storage

# -- S3 / MinIO backend
# Uncomment all of the following when STORAGE_BACKEND=s3.
# Credentials come from the standard AWS chain:
#   AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY env vars, or instance metadata.
# Never put credentials in this file.

# STORAGE_BACKEND=s3
# S3_BUCKET=georef-scans
# S3_REGION=us-east-1
# S3_ENDPOINT=                    # Leave blank for real AWS; set for MinIO e.g. http://minio:9000

# ── Server ────────────────────────────────────────────────────────────────

# Public base URL — used to build stable IIIF and sheet URLs in responses.
# Must not have a trailing slash.
BASE_URL=http://localhost:8080

# Internal URL of the IIIF image server. Never reachable from outside the cluster.
# The server proxies all /iiif/{id}/... requests to this address.
IMAGE_SERVER_URL=http://cantaloupe:8182

# TCP address the HTTP server listens on.
# ADDR=:8080

# Maximum upload size in bytes. Default: 1073741824 (1 GB)
# MAX_UPLOAD_SIZE=1073741824

# How long the server waits for in-flight requests to finish on shutdown.
# Default: 30s
# SHUTDOWN_TIMEOUT=30s

# ── IIIF ──────────────────────────────────────────────────────────────────

# IIIF Image API version served by the image server. Default: 2
# IIIF_IMAGE_API_VERSION=2

# IIIF Image API compliance level. Default: 2
# IIIF_IMAGE_API_LEVEL=2

# How long IIIF sheet status lookups are cached in memory per IIIF path.
# A viewer fetches dozens of tiles per pan/zoom; caching avoids a DB hit each time.
# Default: 5s
# IIIF_STATUS_CACHE_TTL=5s

# Retry-After header value sent on 503 responses while a sheet is converting.
# Default: 5
# RETRY_AFTER_SECONDS=5

# ── Proxy (server) ────────────────────────────────────────────────────────
# Controls the HTTP transport pool used to reach the internal image server.

# PROXY_MAX_IDLE_CONNS=100
# PROXY_MAX_IDLE_CONNS_PER_HOST=20
# PROXY_IDLE_CONN_TIMEOUT=90s
# PROXY_REQUEST_TIMEOUT=2m
# PROXY_MAX_INFO_BODY_SIZE=1048576

# ── Worker ────────────────────────────────────────────────────────────────

# How often the worker polls for new sheets. Default: 5s
POLL_INTERVAL=5s

# Maximum conversion attempts before a sheet is marked permanently failed.
# Default: 3
# MAX_CONVERSION_RETRIES=3

# Pixel dimensions of each tile in the pyramidal TIFF. Default: 256
# VIPS_TILE_WIDTH=256
# VIPS_TILE_HEIGHT=256

# ── GitHub OAuth (write access) ───────────────────────────────────────────
# Leave GITHUB_CLIENT_ID unset to disable authentication (local development).
# When set, POST/PATCH/DELETE /sheets require a session in an allowed team.

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_TEAMS=my-org/contributors

# Session cookie signing key — generate with: openssl rand -base64 32
# SESSION_KEY=

# Set to false only for local HTTP development (disables Secure cookie flag).
# Default: true
# SECURE_COOKIES=true

# Session lifetime in seconds. Default: 604800 (7 days)
# SESSION_MAX_AGE=604800

# ── Read login (IIIF access control) ─────────────────────────────────────
# When READ_LOGIN_REQUIRED=true, GET /iiif/... requires a GitHub session
# or the SERVICE_CREDENTIAL bearer token.
# IIIF responses carry Cache-Control: private when on, public when off.

# READ_LOGIN_REQUIRED=false
# SERVICE_CREDENTIAL=            # Bearer token for server-side callers (e.g. Allmaps tile server)
