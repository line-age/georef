# .env.example — copy to .env for local development.
# Never commit .env — it contains real credentials.
# All variables follow 12-factor III: config in the environment.

# ── Shared (server + worker) ──────────────────────────────────────────────

# Postgres connection string.
DATABASE_URL=postgres://georef:secret@localhost:5432/georef

# Root directory for local file storage.
# Ignored when STORAGE_BACKEND=s3 (Stage 9).
STORAGE_ROOT=/data/storage

# ── Server ────────────────────────────────────────────────────────────────

# Public base URL — used to build stable IIIF and sheet URLs in responses.
# Must not have a trailing slash.
BASE_URL=http://localhost:8080

# TCP address the HTTP server listens on.
ADDR=:8080

# Maximum upload size in bytes.
# Default: 1073741824 (1 GB)
# MAX_UPLOAD_SIZE=1073741824

# ── Worker ────────────────────────────────────────────────────────────────

# Internal URL of the Cantaloupe image server (not reachable from outside).
IMAGE_SERVER_URL=http://cantaloupe:8182

# How often the worker polls for new sheets (Go duration string).
# Default: 5s
POLL_INTERVAL=5s

# Maximum number of conversion retries before a sheet stays in failed state.
# Default: 3
MAX_RETRIES=3

# ── Storage — S3 backend (Stage 9) ───────────────────────────────────────
# Uncomment and set when STORAGE_BACKEND=s3.

# STORAGE_BACKEND=filesystem
# S3_BUCKET=georef-scans
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1

# ── GitHub OAuth (Stage 10) ───────────────────────────────────────────────
# Required when write endpoints are enabled.

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_TEAMS=my-org/contributors

# Session cookie signing key — generate with: openssl rand -hex 32
# SESSION_SECRET=

# ── Read login (Stage 11) ─────────────────────────────────────────────────
# When READ_LOGIN_REQUIRED=true, IIIF requests require a GitHub session
# or the SERVICE_CREDENTIAL bearer token.

# READ_LOGIN_REQUIRED=false
# SERVICE_CREDENTIAL=
